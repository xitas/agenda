{
  "name": "agenda",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=!@agenda/desktop",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "pnpm --filter @agenda/e2e e2e",
    "desktop:installer": "turbo run installer --filter=@agenda/desktop"
  },
  "devDependencies": {
    "@agenda/config": "workspace:*",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  }
}
