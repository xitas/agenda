{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Agenda React DOM app (bundled by Vite)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true
  }
}
