# Copy to .env (git-ignored), then add AGENDA_PASSWORD_HASH. The API won't start without it.

# The hash of your password, never the password itself. This appends the whole line:
#   pnpm -s --filter @agenda/api hash-password >> apps/api/.env
# AGENDA_PASSWORD_HASH=scrypt:17:8:1:...

# "development" makes the session cookie work over plain http://localhost (no Secure flag).
# Leave it out (or use "production") anywhere the API is served over HTTPS.
NODE_ENV=development

# Comma-separated origins of browser apps allowed to call the API with cookies (CORS and the
# CSRF Origin check). Exact origins only: scheme://host[:port], no path or trailing slash.
CORS_ORIGINS=http://localhost:5173

# libSQL URL: a local file in dev, :memory: for throwaway runs, or a Turso URL later.
DATABASE_URL=file:./data/agenda.db

# Port the API listens on.
PORT=4001
