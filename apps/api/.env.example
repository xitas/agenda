# Copy to .env (git-ignored), then add AGENDA_PASSWORD_HASH. The API won't start without it.

# The hash of your password, never the password itself. This appends the whole line:
#   pnpm -s --filter @agenda/api hash-password >> apps/api/.env
# AGENDA_PASSWORD_HASH=scrypt:17:8:1:...

# "development" makes the session cookie work over plain http://localhost (no Secure flag).
# Leave it out (or use "production") anywhere the API is served over HTTPS.
NODE_ENV=development

# Comma-separated origins of the apps whose pages may call the API (CORS), and of the
# web pages whose cookie writes pass the CSRF Origin check. Exact origins only:
# scheme://host[:port], no path or trailing slash.
#   http://localhost:5173    web app (pnpm dev); http://localhost:4173 for vite preview
#   http://localhost:5174    desktop app in dev (pnpm --filter @agenda/desktop dev)
#   http://tauri.localhost   desktop app installed on Windows
#   tauri://localhost        desktop app installed on macOS and Linux
# The desktop app uses a bearer token, which skips the CSRF check; it is listed for CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://tauri.localhost,tauri://localhost

# libSQL URL: a local file in dev, :memory: for throwaway runs, or a Turso URL later.
DATABASE_URL=file:./data/agenda.db

# Port the API listens on.
PORT=4001
