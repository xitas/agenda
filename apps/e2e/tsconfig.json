{
  "extends": "@agenda/config/tsconfig/node.json",
  "compilerOptions": {
    "noEmit": true,
    // Node 24 and Playwright run these files as TypeScript directly: imports name the
    // .ts file, and only syntax that can simply be erased is allowed.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["*.ts", "scripts", "tests"]
}
